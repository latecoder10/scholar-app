# Copy to .env for local development. Never commit the real .env.

# ---------------------------------------------------------------------------
# ENABLE_AUTHORING — controls the two features that write into content/:
#   * the Content Manager uploader   (POST /api/content/upload)
#   * the AI mock expander           (POST /api/chapter/:subject/:chapter/expand)
#
#   true   -> always on
#   false  -> always off
#   unset  -> on in development, OFF in production (the safe default)
#
# These are off in production by default because free/serverless hosts have
# ephemeral disks: an upload appears to succeed and is gone on the next restart.
# Only set this to true on a deployment whose disk actually persists — and note
# there is no authentication, so anyone who can reach the site could upload.
# ---------------------------------------------------------------------------
ENABLE_AUTHORING=true

# ---------------------------------------------------------------------------
# GEMINI_API_KEY — required only for AI question expansion. Without it that
# feature stays off even when ENABLE_AUTHORING=true. Get one from
# https://aistudio.google.com/apikey and verify with: npm run verify:gemini
# ---------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ---------------------------------------------------------------------------
# PORT — the port to bind. Hosting platforms inject this automatically; leave
# it unset locally to use the default 3000.
# ---------------------------------------------------------------------------
# PORT=3000
